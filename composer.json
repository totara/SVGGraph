{
  "name": "totara/svggraph",
  "description": "Totara fork for SVG graph - Generates SVG graphs",
  "license": "LGPL-3.0-only",
  "require": {
    "php": ">=8.2.0",
    "lib-pcre": "*",
    "ext-json": "*"
  },
  "suggest": {
    "ext-iconv": "For non-ASCII text measurement support"
  },
  "autoload": {
    "psr-4": {
      "Goat1000\\SVGGraph\\": ""
    }
  },
  "replace": {
      "goat1000/svggraph": "self.version"
  }
}
